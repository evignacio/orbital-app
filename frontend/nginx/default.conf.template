# Template da imagem oficial do nginx: na subida, o entrypoint renderiza este arquivo
# com envsubst em /etc/nginx/conf.d/default.conf. Só são trocadas as variáveis de
# ambiente que passam no NGINX_ENVSUBST_FILTER (Dockerfile): API_UPSTREAM e
# NGINX_LOCAL_RESOLVERS. As variáveis do próprio nginx ($host, $uri…) ficam intactas.
#   API_UPSTREAM          — onde está a API (padrão http://api:3001, no Dockerfile)
#   NGINX_LOCAL_RESOLVERS — DNS do /etc/resolv.conf (NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1):
#                           127.0.0.11 no Docker, o DNS do cluster no Kubernetes
server {
    # Imagem sem root: porta acima de 1024 (o compose publica 80:8080).
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_proxied any;
    # text/html já é comprimido sempre (repetir aqui só gera um aviso na subida).
    gzip_types text/css application/javascript application/json;

    # Rotas da SPA (/, /painel…): qualquer caminho que não seja arquivo cai no
    # index.html, que sempre revalida (ETag → 304) para um deploy aparecer na hora.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }

    # Assets do Vite têm hash no nome: cache longo e imutável. Sem fallback —
    # um asset que sumiu deve dar 404, não o HTML da SPA. Sem "always", o header
    # só sai em 200/304: um 404 nunca fica um ano no cache.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Estáticos sem hash no nome: cache de 1 dia, depois revalida pelo ETag.
    # Não usar "immutable" — um rebuild troca o conteúdo sem trocar a URL.
    location ~ ^/(favicon\.svg|theme-boot\.(js|css)|_ds/) {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # SSE: sem buffer (cada evento sai na hora) e sem timeout curto de leitura.
    # "location =" casa só o caminho, então ?changes=true também cai aqui.
    location = /api/applications/events {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-hide-security-headers.conf;
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # O frontend chama a API por caminho relativo (/api/...). Resolver + variável
    # fazem o nginx resolver o host da API a cada requisição: sobe mesmo se a API
    # ainda não estiver no ar e acompanha a troca de IP quando o container reinicia.
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-hide-security-headers.conf;
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
